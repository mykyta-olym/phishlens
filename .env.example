# All settings are optional. Pass them with `docker run --env-file .env` or export them.

# Address for `phishlens serve`. The image sets the host to 0.0.0.0.
PHISHLENS_HOST=127.0.0.1
PHISHLENS_PORT=8000

# Load the model from this directory instead of the one inside the package.
# PHISHLENS_MODEL_DIR=
